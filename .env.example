# ==============================================================================
# TEMAN FARMASI — ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ==============================================================================
# Gunakan file ini sebagai acuan pengisian .env.local untuk Development.
# JANGAN PERNAH commit file .env.local atau file yang berisi credential rahasia!
# ==============================================================================

# --- SANITY CMS ---
NEXT_PUBLIC_SANITY_PROJECT_ID=dg157s6c
# Gunakan "development" untuk Dev, "production" untuk Live
NEXT_PUBLIC_SANITY_DATASET=development
NEXT_PUBLIC_SANITY_API_VERSION=2023-01-01
SANITY_API_TOKEN=your_sanity_token_here

# --- SUPABASE DATABASE & AUTH ---
# Kredensial Project Supabase (Gunakan Project DEV untuk local development)
NEXT_PUBLIC_SUPABASE_URL=https://your-dev-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_dev_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_dev_service_role_key_here

# --- APP URL ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
